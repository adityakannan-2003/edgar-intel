# Copy to .env and fill in. Everything here has a working default except the
# LLM key -- the retrieval and evaluation machinery runs entirely locally.

# ------------------------------------------------------------------ database
EDGAR_DB_DSN=postgresql://edgar:edgar@localhost:5433/edgar

# --------------------------------------------------------------------- EDGAR
# The SEC requires a descriptive User-Agent with a contact address on every
# request and rate-limits to 10 requests/second. Both are enforced in
# ingest/edgar_client.py; putting a real address here is not optional.
EDGAR_USER_AGENT="Your Name your.email@example.com"

# ----------------------------------------------------------------- providers
# Any OpenAI-compatible endpoint works: OpenAI, Anthropic via a proxy, Ollama,
# vLLM, LM Studio, Together. Leave EDGAR_LLM_PROVIDER=fake to run the whole
# pipeline deterministically with no network and no spend -- that is what CI
# uses.
EDGAR_LLM_PROVIDER=fake
EDGAR_LLM_BASE_URL=https://api.openai.com/v1
EDGAR_LLM_API_KEY=
EDGAR_LLM_MODEL=gpt-4o-mini
EDGAR_JUDGE_MODEL=gpt-4o-mini

# Cost accounting, USD per 1M tokens. Used for the $/1k-requests figure the
# benchmark reports. Update these when your provider's pricing changes.
EDGAR_COST_PROMPT_PER_MTOK=0.15
EDGAR_COST_COMPLETION_PER_MTOK=0.60

# ---------------------------------------------------------------- embeddings
# local  -> sentence-transformers, runs on CPU, no key, 384 dims
# api    -> OpenAI-compatible /embeddings endpoint
# fake   -> deterministic hash embeddings for tests
EDGAR_EMBED_PROVIDER=local
EDGAR_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EDGAR_EMBED_DIM=384
EDGAR_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ------------------------------------------------------------------ retrieval
EDGAR_DEFAULT_STRATEGY=section_aware
EDGAR_RETRIEVE_K=50
EDGAR_RERANK_TOP_N=8

# --------------------------------------------------------------------- agent
EDGAR_AGENT_MAX_STEPS=8
EDGAR_AGENT_MAX_RETRIES=2
EDGAR_AGENT_CONFIDENCE_FLOOR=0.55

# --------------------------------------------------------------- observability
EDGAR_OTLP_ENDPOINT=
EDGAR_SERVICE_NAME=edgar-intel
